# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!

# Convex Database URL (required for the app to work)
# Get this from your Convex dashboard: https://dashboard.convex.dev
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Anthropic API Key (optional - only needed if using Claude Code CLI)
# Get this from: https://console.anthropic.com
# Note: This should NOT be in .env.local for the Next.js app
# Instead, add it to your shell config (~/.bashrc or ~/.zshrc):
# export ANTHROPIC_API_KEY='your-api-key-here'
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Supabase (currently installed but not actively used)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
